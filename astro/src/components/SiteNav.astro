---
import SubscribeModal from './SubscribeModal.astro';
import config from '../website-config';
import { resolveContentImage } from '../lib/content';
import {
  getUi,
  languageSwitchPath,
  localizedPath,
  otherLang,
  type Lang,
} from '../lib/i18n';

interface Props {
  lang: Lang;
  isHome?: boolean;
  isPost?: boolean;
  postTitle?: string;
  translationPath?: string | null;
  showSubscribe?: boolean;
}

const {
  lang,
  isHome = false,
  isPost = false,
  postTitle,
  translationPath,
  showSubscribe = config.showSubscribe,
} = Astro.props;
const t = getUi(lang);
const logo = resolveContentImage('img/ghost-logo.png');
const switchPath =
  translationPath || languageSwitchPath(Astro.url.pathname, otherLang(lang));
---

{showSubscribe && <SubscribeModal lang={lang} />}
<nav class="site-nav">
  <div class="site-nav-left">
    {
      !isHome && (
        <a class="site-nav-logo" href={localizedPath(lang, '/')}>
          {logo ? <img src={logo.src} alt={config.title} /> : config.title}
        </a>
      )
    }
    <div class="site-nav-content" data-nav-content>
      <ul role="menu">
        <li role="menuitem">
          <a href={localizedPath(lang, '/')}>{t.navHome}</a>
        </li>
        <li role="menuitem">
          <a href={localizedPath(lang, '/projects/')}>{t.navProjects}</a>
        </li>
        <li role="menuitem">
          <a href={localizedPath(lang, '/tags/dev/')}>{t.navDev}</a>
        </li>
        <li role="menuitem">
          <a href={localizedPath(lang, '/tags/how-to/')}>{t.navHowTo}</a>
        </li>
        <li role="menuitem">
          <a href="https://slides.mattianatali.dev" target="_blank" rel="noreferrer">
            {t.navSlides}
          </a>
        </li>
        <li role="menuitem">
          <a href={switchPath}>{t.languageName}</a>
        </li>
      </ul>
      {
        isPost && (
          <span class="nav-post-title" data-nav-title>
            {postTitle}
          </span>
        )
      }
    </div>
  </div>
  <div class="site-nav-right">
    <div class="social-links">
      {
        config.linkedin && (
          <a
            class="social-link"
            href={config.linkedin}
            target="_blank"
            title="LinkedIn"
            rel="noopener noreferrer"
          >
            <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
        )
      }
      {
        config.github && (
          <a
            class="social-link"
            href={config.github}
            target="_blank"
            title="GitHub"
            rel="noopener noreferrer"
          >
            <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          </a>
        )
      }
      {
        config.facebook && (
          <a
            class="social-link social-link-fb"
            href={config.facebook}
            target="_blank"
            title="Facebook"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
              <path d="M16 0c8.837 0 16 7.163 16 16s-7.163 16-16 16S0 24.837 0 16 7.163 0 16 0zm5.204 4.911h-3.546c-2.103 0-4.443.885-4.443 3.934.01 1.062 0 2.08 0 3.225h-2.433v3.872h2.509v11.147h4.61v-11.22h3.042l.275-3.81h-3.397s.007-1.695 0-2.187c0-1.205 1.253-1.136 1.329-1.136h2.054V4.911z" />
            </svg>
          </a>
        )
      }
      {
        config.twitter && (
          <a
            class="social-link"
            href={config.twitter}
            title="X"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
              <path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z" />
            </svg>
          </a>
        )
      }
    </div>
    {
      showSubscribe && (
        <a class="subscribe-button" data-subscribe-open>
          {t.navFollow}
        </a>
      )
    }
  </div>
</nav>

<script>
  const navContent = document.querySelector<HTMLElement>('[data-nav-content]');
  const navTitle = document.querySelector<HTMLElement>('[data-nav-title]');

  if (navContent && navTitle) {
    let ticking = false;

    const update = () => {
      const trigger = navTitle.getBoundingClientRect().top;
      const triggerOffset = navTitle.offsetHeight + 35;
      navContent.classList.toggle('hide-nav', window.scrollY >= trigger + triggerOffset);
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(update);
      }
      ticking = true;
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }
</script>
