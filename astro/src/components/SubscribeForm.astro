---
import config from '../website-config';
import { getUi, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
const emailFieldName = config.mailchimpEmailFieldName ?? 'EMAIL';
---

<form
  novalidate
  class="subscribe-form"
  action={config.mailchimpAction}
  method="post"
  id="mc-embedded-subscribe-form"
  name="mc-embedded-subscribe-form"
  target="_blank"
>
  <div class="form-group">
    <input
      class="subscribe-email"
      type="email"
      name={emailFieldName}
      id={emailFieldName}
      placeholder={t.subscribePlaceholder}
    />
  </div>
  <div style="position:absolute;left:-5000px" aria-hidden="true">
    <input type="text" name={config.mailchimpName} tabindex="-1" />
  </div>
  <button class="btn subscribe-form-button" type="submit">
    <span>{t.subscribeButton}</span>
  </button>
</form>
