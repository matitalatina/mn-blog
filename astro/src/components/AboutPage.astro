---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from './Footer.astro';
import PostContent from './PostContent.astro';
import SiteNav from './SiteNav.astro';
import Wrapper from './Wrapper.astro';
import config from '../website-config';
import { getUi, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
const site = config.siteUrl;
const canonicalUrl = `${site}/${lang}/about/`;
const alternates = [
  { hreflang: 'it', href: `${site}/it/about/` },
  { hreflang: 'en', href: `${site}/en/about/` },
  { hreflang: 'x-default', href: `${site}/it/about/` },
];
const content: Record<Lang, string[]> = {
  it: [
    'Sono Mattia Natali, engineering manager e sviluppatore. Scrivo di sviluppo software, DevOps, produttività e tutto ciò che imparo lungo il percorso.',
    'Questo blog raccoglie i miei articoli tecnici in italiano e in inglese. Puoi cambiare lingua dal menu di navigazione.',
  ],
  en: [
    "I'm Mattia Natali, an engineering manager and developer. I write about software development, DevOps, productivity, and everything I learn along the way.",
    'This blog collects my technical articles in Italian and English. You can switch language from the navigation menu.',
  ],
};
---

<BaseLayout
  lang={lang}
  title={t.aboutHeadTitle}
  canonicalUrl={canonicalUrl}
  ogType="website"
  alternates={alternates}
  googleSiteVerification={config.googleSiteVerification}
>
  <Wrapper class="page-template">
    <header class="site-archive-header no-image">
      <div class="outer site-nav-main">
        <div class="inner">
          <SiteNav lang={lang} />
        </div>
      </div>
    </header>
    <main id="site-main" class="site-main outer">
      <div class="inner">
        <article class="post page no-image">
          <header class="post-full-header">
            <h1 class="post-full-title">{t.aboutTitle}</h1>
          </header>
          <PostContent class="post-content">
            {content[lang].map(paragraph => <p>{paragraph}</p>)}
          </PostContent>
        </article>
      </div>
    </main>
    <Footer lang={lang} />
  </Wrapper>
</BaseLayout>
