---

<div class="share-buttons">
  {
    icons.map(icon => (
      <a
        class="share-button"
        href={icon.href}
        target="_blank"
        rel="noopener noreferrer"
        title={icon.label}
        aria-label={icon.label}
      >
        <svg viewBox="0 0 64 64" width="40" height="40">
          <circle cx="32" cy="32" r={icon.radius} fill={icon.color} />
          <path d={icon.path} fill="white" />
        </svg>
      </a>
    ))
  }
</div>
